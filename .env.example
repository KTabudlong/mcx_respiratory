# Local dev (`npm run dev`): copy this to .env.local and fill it in with the same values as .env.production.
# Production builds (`npm run build`, GitHub Pages) read .env.production, which is committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
